<mxfile host="app.diagrams.net"><diagram name="Master" id="pgM"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="MASTER FLOW · single-item, manual (no-AI) — v2.5 · 7 pages · state-gated OVERLAY: unmarked = shared · ◆ = value knob · ▲ = state branch" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="26" as="geometry"/></mxCell><mxCell id="g1" value="◆ Request submitted&#10;Portal · Online form · Clerk (paper) ·&#10;Oral/phone (OH·GA·LA·MA·MI·MO·NV·WI)&#10;→ normalized to ≤10 items" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="56" width="214" height="88" as="geometry"/></mxCell><mxCell id="no" value="ORAL CHANNEL (state-gated)&#10;OH: office may ask for writing / ID / purpose only&#10;AFTER disclosing they are optional (OH-0006);&#10;denial explanation must be written only if the&#10;request was written (OH-0015) → channel captured&#10;at intake drives later communication duties" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1130" y="50" width="320" height="112" as="geometry"/></mxCell><mxCell id="g2" value="▲ Requester eligible?&#10;(state-gated: residency ·&#10;citizenship · incarcerated)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="248" y="54" width="204" height="92" as="geometry"/></mxCell><mxCell id="g3" value="MRR?&#10;(this pass: single)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="462" y="66" width="150" height="68" as="geometry"/></mxCell><mxCell id="g4" value="◆ Acknowledgment auto-sent&#10;(parent flag ✓)&#10;muted where “no duty to&#10;attach” a vague request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="646" y="58" width="214" height="84" as="geometry"/></mxCell><mxCell id="s1" value="▲ Fee-waiver requested&#10;(side path → ledger)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="50" width="214" height="50" as="geometry"/></mxCell><mxCell id="s2" value="▲ Commercial-rate requested&#10;(side path → ledger)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="900" y="108" width="214" height="50" as="geometry"/></mxCell><mxCell id="lane" value="CHILD — Process Status (the work) → drives “My Tasks”" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="20" y="196" width="520" height="20" as="geometry"/></mxCell><mxCell id="p1" value="In Review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="236" width="150" height="60" as="geometry"/></mxCell><mxCell id="p2" value="Intake Review&#10;+ Preliminary Search&#10;(designate request type)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="210" y="228" width="182" height="76" as="geometry"/></mxCell><UserObject label="◆ Estimate Data&#10;(template · manual · letter)&#10;▸ open Estimate/Fee sub-flow" link="data:page/id,pgE" id="p3"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=2.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="432" y="224" width="182" height="84" as="geometry"/></mxCell></UserObject><mxCell id="dd" value="◆ Deposit before&#10;work? (config)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="654" y="236" width="150" height="60" as="geometry"/></mxCell><UserObject label="Records Search (full)&#10;(if not in prelim ·&#10;IT · police-video)&#10;▸ open Search sub-flow" link="data:page/id,pgS" id="p4"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=2.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="844" y="224" width="182" height="84" as="geometry"/></mxCell></UserObject><UserObject label="Redaction&#10;(auto if none)&#10;▸ open Redaction&#10;sub-flow" link="data:page/id,pgR" id="p5"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=2.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1066" y="228" width="150" height="76" as="geometry"/></mxCell></UserObject><mxCell id="p6" value="SHIPPED&#10;(gated by payment-&#10;adequate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1262" y="232" width="168" height="68" as="geometry"/></mxCell><UserObject label="Disposition &amp; delivery&#10;▸ open sub-flow" link="data:page/id,pgX" id="pd"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=2.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1262" y="312" width="168" height="48" as="geometry"/></mxCell></UserObject><UserObject label="◆ VAGUE → Clarification&#10;await response (implied-ext clock)&#10;→ resolve ↑ or timeout → Closed&#10;▸ open Clarification sub-flow" link="data:page/id,pgC" id="bv"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=2.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="368" width="238" height="100" as="geometry"/></mxCell></UserObject><UserObject label="DENIAL&#10;reasons from config library →&#10;direct or → Legal review&#10;▸ open Denial sub-flow" link="data:page/id,pgD" id="bd"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;strokeWidth=2.5;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="368" width="232" height="100" as="geometry"/></mxCell></UserObject><mxCell id="bn" value="◆ NO RECORD FOUND&#10;“not found — contact us” comm →&#10;implied-ext (+3d) → auto-close (10d)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="828" y="372" width="262" height="92" as="geometry"/></mxCell><mxCell id="br" value="▲ NOT OURS → proper custodian&#10;state-gated duty: forward internally (MI·NJ·UT) ·&#10;notify + identify custodian (CO·KS·LA·MA·NV·OR·VA)&#10;· courtesy only (AL·TN) · NO duty (OH — config)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1110" y="372" width="330" height="100" as="geometry"/></mxCell><mxCell id="tc" value="CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="506" width="150" height="54" as="geometry"/></mxCell><mxCell id="td" value="DENIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="744" y="506" width="150" height="54" as="geometry"/></mxCell><mxCell id="l1" value="Legal Review – Denial (UI, submit)&#10;spawns: Intake / Search / Redaction /&#10;Legal-Redaction → Closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="596" width="232" height="74" as="geometry"/></mxCell><mxCell id="l2" value="Legal Redaction (UI, submit)&#10;spawns: Intake / Search / Redaction&#10;→ back to spine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="828" y="596" width="262" height="74" as="geometry"/></mxCell><mxCell id="fin" value="PARENT — Financial Processor &amp; Accounting" style="rounded=0;verticalAlign=top;fontStyle=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="1120" height="176" as="geometry"/></mxCell><mxCell id="f1" value="Ledger: child lines → compute per line →&#10;apply per-request allowances/caps → total / invoice" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="742" width="338" height="66" as="geometry"/></mxCell><mxCell id="f2" value="◆ Estimate Review (config: $ threshold +&#10;reviewer: self / supervisor / open-records / finance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="394" y="742" width="300" height="66" as="geometry"/></mxCell><mxCell id="f3" value="Payment receipt&#10;screen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="710" y="742" width="168" height="66" as="geometry"/></mxCell><mxCell id="f5" value="→ ship-auth (payment-adequate) gates SHIPPED&#10;→ Hold suppresses child from My Tasks&#10;→ Closed–Nonpayment ⇒ Active/Closed = Closed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="894" y="742" width="230" height="66" as="geometry"/></mxCell><mxCell id="f4" value="Flags:   Active / Closed        ·        Financial Status:   OK  /  Hold–Awaiting Payment  /  Closed–Nonpayment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="820" width="1084" height="44" as="geometry"/></mxCell><mxCell id="nc" value="CLOCK  •  Numeric-deadline states:  extended_due = received + statutory_days + implied_extension&#10;(implied_extension = 0 default; triggers: clarification · “additional time” letter · no-record contact-us +3d)&#10;•  Soft-standard states (e.g. OH “promptly / reasonable” — no number):  NO legal due date →&#10;city sets an internal OPERATIONAL target (drives My Tasks / aging), explicitly NOT a legal deadline." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="888" width="720" height="108" as="geometry"/></mxCell><mxCell id="nv" value="VISIBILITY  My Tasks = child Process Status (hidden on Hold)&#10;Request Queue = parent Active/Closed (Hold shown, not removed)" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="760" y="888" width="400" height="74" as="geometry"/></mxCell><mxCell id="pgM_ovleg" value="OVERLAY:  unmarked = SHARED logic (identical everywhere)   ·   ◆ = VALUE KNOB (per-state/city config fills a value)   ·   ▲ = STATE-GATED BRANCH (active only for some states)" style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="20" y="974" width="1100" height="20" as="geometry"/></mxCell><mxCell id="pgM_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e2" value="no / yes(attested)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e3" value="no (single)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="g4" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="s1" target="fin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="s2" target="fin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p1" target="p2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p2" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p3" target="dd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dd" target="p4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e11" value="yes → Hold" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dd" target="fin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p4" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p5" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e14" value="vague" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p2" target="bv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e15" value="resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="bv" target="p3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e16" value="timeout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="bv" target="tc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e17" value="deny" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p2" target="bd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p4" target="bd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p5" target="bd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="bd" target="td"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e21" value="to legal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="bd" target="l1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e22" value="none" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p4" target="bn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="bn" target="tc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e24" value="not ours" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p2" target="br"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="br" target="tc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e26" value="estimate submit → fee calc" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p3" target="fin"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e27" value="payment-adequate" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="fin" target="p6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="l1" target="tc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p4" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="p5" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgM_e31" value="back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="l2" target="p5"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Clarification" id="pgC"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1120" pageHeight="1140"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Clarification sub-flow (child-level) — shared spine; per-state = params + gated branches" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="760" height="26" as="geometry"/></mxCell><mxCell id="n1" value="Item marked VAGUE at Intake Review&#10;(child-level decision)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="58" width="300" height="54" as="geometry"/></mxCell><mxCell id="d1" value="▲ Assist / confer required&#10;before any denial?&#10;(state-gated)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="146" width="260" height="80" as="geometry"/></mxCell><mxCell id="deny" value="▲ Deny as vague / overbroad&#10;(TN · NJ · OH — OH must still offer revise;&#10;OK only AFTER engagement — SB 535)&#10;→ DENIAL sub-flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="152" width="330" height="70" as="geometry"/></mxCell><mxCell id="n2" value="◆ Send clarification / assist request&#10;(may itself be due within the response window;&#10;TX: letter MUST state consequences of&#10;non-response — § 552.222(d))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="350" y="268" width="300" height="64" as="geometry"/></mxCell><mxCell id="d2" value="▲ Clock effect of sending?&#10;(state-gated)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="372" width="260" height="80" as="geometry"/></mxCell><mxCell id="ct" value="TOLL / RESTART:&#10;AL restart · OR · TX toll → clock pauses" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="378" width="300" height="68" as="geometry"/></mxCell><mxCell id="ci" value="NO PAUSE (most states) → IMPLIED-EXTENSION&#10;extended_due = received + statutory_days&#10;+ implied_extension (triggered here)" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="372" width="340" height="80" as="geometry"/></mxCell><mxCell id="n3" value="◆ Await requester response&#10;Response deadline:&#10;• MO = 90d · TX = 61 days (statutory)&#10;• KS = soft “reasonable efforts”&#10;• all others = CITY SOFT-POLICY (config)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#c0a000;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="500" width="340" height="96" as="geometry"/></mxCell><mxCell id="gap" value="⚠ GAP (narrowed 2026-07-26)&#10;The requester-response window &amp;&#10;close-on-nonresponse are statutory ONLY in&#10;MO (90d) + TX (61d, § 552.222(e));&#10;KS soft; all others silent.&#10;→ elsewhere this edge is a CONFIG KNOB, not law." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="720" y="486" width="360" height="110" as="geometry"/></mxCell><mxCell id="d3" value="Responded by&#10;deadline?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="636" width="240" height="64" as="geometry"/></mxCell><mxCell id="close" value="◆ CLOSE item (withdrawn)&#10;MO 90d · TX 61d · KS soft · else city policy&#10;→ CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="628" width="300" height="80" as="geometry"/></mxCell><mxCell id="n4" value="Revised request received" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="736" width="260" height="50" as="geometry"/></mxCell><mxCell id="d4" value="◆ Materially revised?&#10;(design / config — no statute)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="370" y="822" width="280" height="80" as="geometry"/></mxCell><mxCell id="nnew" value="Treat as NEW request →&#10;new receipt &amp; clock →&#10;re-enter Intake Review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="828" width="330" height="64" as="geometry"/></mxCell><mxCell id="d5" value="Reasonably&#10;described now?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="390" y="932" width="240" height="64" as="geometry"/></mxCell><mxCell id="resume" value="RESUME processing&#10;(clock per toll decision above)&#10;→ back to spine (Estimate Data)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="320" y="1030" width="360" height="64" as="geometry"/></mxCell><mxCell id="duty" value="▲ Still vague after reasonable effort →&#10;Duty satisfied (CA-0008) →&#10;deny / close → CLOSED / DENIED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="30" y="1024" width="300" height="80" as="geometry"/></mxCell><mxCell id="leg" value="STATE COVERAGE&#10;Assist: CA·NJ·NV·TN·WA    Confer: IL·KS·NV·OH·OK&#10;Explicit toll: AL·OR·TX (TX re-measures 10-bd AG clock)&#10;Statutory response deadline: MO 90d · TX 61d&#10;Deny-as-vague: TN·NJ·OH · OK only after engagement&#10;Duty satisfied: CA&#10;OK specificity (SB 535): time-frame · identifiable&#10;records · search terms" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="940" width="380" height="150" as="geometry"/></mxCell><mxCell id="pgC_ovleg" value="OVERLAY:  unmarked = SHARED logic (identical everywhere)   ·   ◆ = VALUE KNOB (per-state/city config fills a value)   ·   ▲ = STATE-GATED BRANCH (active only for some states)" style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="20" y="1114" width="1080" height="20" as="geometry"/></mxCell><mxCell id="pgC_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="n1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e2" value="deny allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d1" target="deny"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e3" value="assist / confer first" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d1" target="n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="n2" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d2" target="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="n3" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e7" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d3" target="close"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d3" target="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="n4" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e10" value="yes → material" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d4" target="nnew"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e11" value="no → resume original" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d4" target="d5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e12" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d5" target="resume"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgC_e13" value="no / still vague" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d5" target="duty"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Estimate-Fee" id="pgE"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1260" pageHeight="990"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="cb" value="CHILD — Estimate Data (per item)" style="rounded=0;verticalAlign=top;align=left;fontStyle=2;fontColor=#888;dashed=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#dddddd;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="48" width="1200" height="336" as="geometry"/></mxCell><mxCell id="pb" value="PARENT — Financial Processor &amp; Accounting" style="rounded=0;verticalAlign=top;align=left;fontStyle=2;fontColor=#888;dashed=1;whiteSpace=wrap;html=1;fillColor=#fbfbfd;strokeColor=#dddddd;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="398" width="1200" height="470" as="geometry"/></mxCell><mxCell id="title" value="Estimate / Fee sub-flow — child entry + parent financial processor" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="26" as="geometry"/></mxCell><mxCell id="e1" value="From Intake Review&#10;(record maybe attached via prelim search)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="86" width="290" height="54" as="geometry"/></mxCell><mxCell id="dreq" value="◆ Estimate required?&#10;(threshold: $ / hours —&#10;per-state parameter)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="78" width="240" height="78" as="geometry"/></mxCell><mxCell id="skip" value="No → $0 / minimal →&#10;proceed to work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="86" width="250" height="54" as="geometry"/></mxCell><mxCell id="dtmpl" value="Record attached /&#10;template match?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="190" width="240" height="86" as="geometry"/></mxCell><mxCell id="tmpl" value="TEMPLATE → auto-fill&#10;estimate lines" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="200" width="270" height="58" as="geometry"/></mxCell><mxCell id="addt" value="◆ NOT ESTIMABLE YET →&#10;“additional time” letter (delay;&#10;soft/“reasonable” → implied-ext)&#10;→ loop when data ready" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="720" y="188" width="300" height="88" as="geometry"/></mxCell><mxCell id="manual" value="or MANUAL entry (knowledge)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="410" y="300" width="240" height="42" as="geometry"/></mxCell><mxCell id="esub" value="Submit estimate data (child)&#10;→ rolls up as a parent line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="348" width="250" height="44" as="geometry"/></mxCell><mxCell id="fled" value="Ledger: per-line → aggregate →&#10;apply per-request allowances/caps → TOTAL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="330" height="66" as="geometry"/></mxCell><mxCell id="dwv" value="▲ Fee waiver&#10;requested? (19st)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="424" width="190" height="60" as="geometry"/></mxCell><mxCell id="wrev" value="▲ Review (public-interest / indigent /&#10;victim / resident-free) → grant(adjust) / deny" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="660" y="420" width="350" height="66" as="geometry"/></mxCell><mxCell id="frev" value="◆ Estimate Review (config: $ threshold + reviewer:&#10;self / supervisor / open-records / finance)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="512" width="330" height="60" as="geometry"/></mxCell><mxCell id="fcom" value="◆ Send itemized good-faith estimate /&#10;invoice (due within N days: GA 3bd…)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="512" width="290" height="60" as="geometry"/></mxCell><mxCell id="drsp" value="◆ Requester response&#10;required?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="506" width="230" height="74" as="geometry"/></mxCell><mxCell id="optout" value="◆ opt-out / no response&#10;→ CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="612" width="230" height="54" as="geometry"/></mxCell><mxCell id="ddep" value="◆ Deposit / pay before&#10;work? (config; ~21st&#10;permit; AL t-i requires)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="610" width="270" height="80" as="geometry"/></mxCell><mxCell id="hold" value="HOLD–Awaiting Payment&#10;(parent override → hides child&#10;from My Tasks)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#c0a000;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="616" width="330" height="64" as="geometry"/></mxCell><mxCell id="paid" value="paid → resume" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="708" width="150" height="46" as="geometry"/></mxCell><mxCell id="cnp" value="◆ nonpayment (MO 90d · OR 60d ·&#10;else config) → CLOSED–Nonpayment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="210" y="706" width="300" height="64" as="geometry"/></mxCell><mxCell id="proc" value="▲ No → proceed to work; collect at end&#10;(pay-before-release: AL·AZ·IL·KS·&#10;MA·NE·NV·OH → Hold at delivery)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="560" y="706" width="300" height="64" as="geometry"/></mxCell><mxCell id="exit" value="→ back to child spine (Search → Redaction);&#10;balance at disposition → Awaiting Payment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="800" width="430" height="54" as="geometry"/></mxCell><mxCell id="gap" value="⚠ GAP: requester-response-to-estimate window &amp; close-on-&#10;nonpayment are clean statute only in TX·IL (10bd), OR (60d),&#10;MO (90d); LA soft; ALL OTHERS = configurable city policy." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="884" width="600" height="84" as="geometry"/></mxCell><mxCell id="chick" value="Chicken-and-egg: the estimate must include redaction labor,&#10;but that needs the record → why Preliminary Search feeds&#10;this stage (see Intake)." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="884" width="300" height="84" as="geometry"/></mxCell><mxCell id="leg" value="STATE COVERAGE&#10;Estimate rule: AL·GA·MA·MO·TN·TX·VA&#10;Threshold: GA$25 · OR$25 · TX$40 · KS5h · NY2h&#10;Deposit / advance: 21 states · OK statutory:&#10;&gt;$75 est. OR unpaid prior fees (SB 535, 11/25)&#10;Pay-before-release: AL·AZ·IL·KS·MA·NE·NV·OH&#10;Nonpayment-close: MO90d · OR60d · LA soft&#10;Waiver: 19 states&#10;Cross-request triggers (requestor-level ledger):&#10;TX 552.263(c)/552.275 · OK unpaid-fees" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="960" y="600" width="270" height="266" as="geometry"/></mxCell><mxCell id="pgE_ovleg" value="OVERLAY:  unmarked = SHARED logic (identical everywhere)   ·   ◆ = VALUE KNOB (per-state/city config fills a value)   ·   ▲ = STATE-GATED BRANCH (active only for some states)" style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="20" y="964" width="1100" height="20" as="geometry"/></mxCell><mxCell id="pgE_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="e1" target="dreq"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e2" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dreq" target="skip"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dreq" target="dtmpl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e4" value="template" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dtmpl" target="tmpl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e5" value="manual" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dtmpl" target="manual"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e6" value="not estimable" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dtmpl" target="addt"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e7" value="when ready" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="addt" target="dtmpl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="tmpl" target="esub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="manual" target="esub"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="skip" target="exit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="esub" target="fled"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="fled" target="dwv"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e13" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dwv" target="wrev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e14" value="adjust" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="wrev" target="frev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dwv" target="frev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="frev" target="fcom"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="fcom" target="drsp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e18" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="drsp" target="optout"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e19" value="yes / pays" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="drsp" target="ddep"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="ddep" target="hold"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="ddep" target="proc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e22" value="paid" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="hold" target="paid"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e23" value="nonpay" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="hold" target="cnp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="paid" target="exit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgE_e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="proc" target="exit"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Denial" id="pgD"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1240" pageHeight="1160"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Denial sub-flow — config reason-library + legal routing; deemed-denial is clock-driven; AG-referral states have NO staff denial" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="26" as="geometry"/></mxCell><mxCell id="e1" value="DENY clicked&#10;(from Intake · Search · Redaction · Legal-Redaction)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="56" width="380" height="54" as="geometry"/></mxCell><mxCell id="dag" value="▲ Mandatory EXTERNAL ruling&#10;to withhold? (state-gated:&#10;TX — no staff denial)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="810" y="50" width="310" height="74" as="geometry"/></mxCell><mxCell id="ntypes" value="DENIAL TYPES:&#10;• full — record exempt&#10;• partial → Redaction / segregability&#10;• no responsive records (MI·TN·UT · TX 10bd)&#10;• burden / vexatious (IL·KS·PA · OH gate)&#10;• vague / overbroad → Clarification (NJ·OH·OK)&#10;• neither-confirm-nor-deny (OR)&#10;• AG-referral — no staff denial (TX)" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="352" height="138" as="geometry"/></mxCell><mxCell id="nreason" value="◆ Select reason(s) from config library&#10;(AI-filled at setup from exemption&#10;catalog; edit / attest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="150" width="330" height="74" as="geometry"/></mxCell><mxCell id="dlegal" value="◆ Legal approval&#10;required?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="262" width="280" height="84" as="geometry"/></mxCell><mxCell id="ncfg" value="Config: always-route-to-legal ON → forced.&#10;OFF → user picks “submit for legal approval”&#10;or “submit” (direct to comm).&#10;Any city may force-route denials to legal." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="258" width="360" height="96" as="geometry"/></mxCell><mxCell id="legal" value="Legal Review – Denial&#10;(dedicated UI, submit-complete)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="384" width="300" height="58" as="geometry"/></mxCell><mxCell id="dlegok" value="Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="835" y="470" width="170" height="64" as="geometry"/></mxCell><mxCell id="back" value="rejected → back to processing&#10;(re-enter spine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="566" width="300" height="54" as="geometry"/></mxCell><mxCell id="ncomm" value="◆ Compose denial communication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="384" width="330" height="86" as="geometry"/></mxCell><mxCell id="ncontent" value="CONTENT (assembled per state):&#10;• reasons + exemption citation (13st)&#10;• responsible person (CA·NE)&#10;• partial particularity (VA) — if partial&#10;• no-records notice (MI·TN·UT · TX 10bd) — if no-records&#10;• previous-determination id (TX 10bd, § 552.221(g))&#10;• appeal-rights block — CITY-DRAFTED (not a rule)" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="372" width="352" height="150" as="geometry"/></mxCell><mxCell id="ddl" value="◆ Denial deadline?&#10;(CT 4bd · KS/MO 3bd ·&#10;IN 24hr/7d; else resp. window)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="506" width="280" height="84" as="geometry"/></mxCell><mxCell id="send" value="Send denial comm → child status = DENIED&#10;→ (single item: request denied) → CLOSED" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="410" y="622" width="350" height="60" as="geometry"/></mxCell><mxCell id="deemed" value="DEEMED / CONSTRUCTIVE DENIAL  (clock-driven, 16 states)&#10;No response by the deadline → auto-denied (AL 30/180bd rebuttable&#10;presumption; IN 24hr in-person / 7d mail). System AVOIDS this by&#10;responding in time; the requestor’s remedy is external (out of scope).&#10;↔ TX INVERTS this — see DEEMED DISCLOSURE in the AG band below." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="710" width="560" height="96" as="geometry"/></mxCell><mxCell id="lib" value="CONFIG LIBRARY: every state has an exemption /&#10;denial-reason list → loaded once at setup&#10;(upload → AI draft → edit → attest),&#10;same pattern as all other config." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="710" width="290" height="96" as="geometry"/></mxCell><mxCell id="leg" value="STATE COVERAGE&#10;Reasons + citation: 13 states&#10;Responsible person: CA · NE&#10;Partial notice: VA&#10;No-records notice: MI · TN · UT · TX (10bd)&#10;Burden / vexatious: IL · KS · PA · OH (2323.52(J))&#10;Denial deadline: CT · KS · MO · IN&#10;Deemed denial: 16 states · Deemed DISCLOSURE: TX&#10;Neither-confirm-nor-deny: OR&#10;AG-ruling-to-withhold: TX (10bd hard)&#10;Appeal-rights content: city-drafted" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="910" y="506" width="300" height="300" as="geometry"/></mxCell><mxCell id="agband" value="AG-REFERRAL BAND (state-gated: TX + any future AG-ruling state) — “to withhold, petition the external authority in time — or the record goes public”" style="text;html=1;fontSize=12;fontStyle=2;align=left;fontColor=#555;" vertex="1" parent="1"><mxGeometry x="20" y="830" width="1200" height="20" as="geometry"/></mxCell><mxCell id="dprev" value="▲ Previous determination&#10;covers this info?&#10;(§ 552.301(a) exception)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="868" width="300" height="76" as="geometry"/></mxCell><mxCell id="ag1" value="▲ Prepare AG ruling request —&#10;must state the SPECIFIC exceptions&#10;claimed (§ 552.301(b), HB 4219)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="360" y="868" width="300" height="76" as="geometry"/></mxCell><mxCell id="agclk" value="▲ HARD CLOCKS (from receipt;&#10;clarification re-measures):&#10;submit by 10th bd · comments,&#10;request copy + samples by 15th bd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#c0a000;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="700" y="868" width="280" height="76" as="geometry"/></mxCell><mxCell id="agnot" value="▲ Requestor notices:&#10;withholding + AG-request (10bd);&#10;redacted comments copy (15bd)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="868" width="220" height="76" as="geometry"/></mxCell><mxCell id="agwait" value="▲ AWAIT AG ruling [external]&#10;≈45bd (+10 ext) — informational,&#10;not a city duty" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="980" width="220" height="64" as="geometry"/></mxCell><mxCell id="agdec" value="▲ AG ruling?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="700" y="980" width="240" height="64" as="geometry"/></mxCell><mxCell id="agrel" value="▲ RELEASE ordered / deemed public →&#10;back to spine (Redaction → Shipped)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="1064" width="320" height="54" as="geometry"/></mxCell><mxCell id="agmiss" value="DEEMED DISCLOSURE (inverts deemed-denial): miss the 10-bd/15-bd clocks →&#10;information PRESUMED PUBLIC (§ 552.302) — release absent compelling reason.&#10;Post-HB 4219 no request silently closes: five 10-bd exits (produce · certify&#10;date · no-records · previous-determination · AG request)." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="980" width="640" height="72" as="geometry"/></mxCell><mxCell id="pgD_ovleg" value="OVERLAY:  unmarked = SHARED logic (identical everywhere)   ·   ◆ = VALUE KNOB (per-state/city config fills a value)   ·   ▲ = STATE-GATED BRANCH (active only for some states)" style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="20" y="1134" width="1100" height="20" as="geometry"/></mxCell><mxCell id="pgD_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="e1" target="nreason"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="nreason" target="dag"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e3" value="no — staff denial allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dag" target="dlegal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e4" value="yes (TX)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dag" target="dprev"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e5" value="yes → § 552.221(g) notice ids the specific prior determination (10bd)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dprev" target="ncomm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e6" value="no → must petition AG" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dprev" target="ag1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="ag1" target="agclk"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="agclk" target="agnot"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="agnot" target="agwait"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="agwait" target="agdec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e11" value="withhold approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="agdec" target="ncomm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e12" value="release ordered" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="agdec" target="agrel"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e13" value="missed" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="agclk" target="agmiss"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e14" value="yes / route" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dlegal" target="legal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e15" value="no → direct submit" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dlegal" target="ncomm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="legal" target="dlegok"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e17" value="approved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dlegok" target="ncomm"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e18" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="dlegok" target="back"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="ncomm" target="ddl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgD_e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="ddl" target="send"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Records-Search" id="pgS"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="980"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Records Search sub-flow — reasonable search · no-duty-to-create · programming loop · installments · special-record overlay" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="980" height="26" as="geometry"/></mxCell><mxCell id="e1" value="From spine: Estimate/Deposit cleared&#10;(scope = request as clarified/narrowed)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="300" height="60" as="geometry"/></mxCell><mxCell id="s1" value="Route to custodian department(s)&#10;(multi-dept fan-out; each confirms&#10;search done or none-held)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="56" width="300" height="68" as="geometry"/></mxCell><mxCell id="s2" value="Reasonable, good-faith search where records&#10;are kept in the ordinary course&#10;(organize-and-maintain duty: OH·WA)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="56" width="340" height="68" as="geometry"/></mxCell><mxCell id="d1" value="Anything responsive?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="170" width="280" height="70" as="geometry"/></mxCell><mxCell id="bn" value="◆ NONE → NO RECORD FOUND (master branch)&#10;“not found — contact us” · implied-ext +3d&#10;TX: WRITTEN no-records notice by 10th bd (TX-S01)&#10;OH: none-exists statement = denial → (B)(3) explanation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="330" height="96" as="geometry"/></mxCell><mxCell id="d2" value="Needs creation /&#10;compilation of a&#10;NEW record?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="290" width="280" height="80" as="geometry"/></mxCell><mxCell id="nod" value="NO DUTY TO CREATE (16 states):&#10;answering questions · legal research ·&#10;new compilations — decline that part&#10;→ partial no-records / denial comm" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="300" width="330" height="84" as="geometry"/></mxCell><mxCell id="prog" value="▲ BUT extraction/programming of EXISTING&#10;electronic data ≠ creation → cost it:&#10;TX 552.231 written statement + estimate in 20d (+10);&#10;requester 30d to respond or withdrawn&#10;→ loops to Estimate sub-flow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="300" width="340" height="92" as="geometry"/></mxCell><mxCell id="d3" value="Already posted online?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="420" width="280" height="70" as="geometry"/></mxCell><mxCell id="web" value="▲ WEBSITE SATISFIES (8 states incl. OK ¶6):&#10;point to posting (NJ: if copy still requested&#10;→ special multiplier rate)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="420" width="340" height="74" as="geometry"/></mxCell><mxCell id="d4" value="Voluminous?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="540" width="280" height="64" as="geometry"/></mxCell><mxCell id="inst" value="◆ INSTALLMENTS / partial production (7 states):&#10;release as located · time estimate ·&#10;per-installment fees per config" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="380" y="540" width="340" height="74" as="geometry"/></mxCell><mxCell id="spec" value="▲ SPECIAL-RECORD CLASS? (overlay)&#10;law-enforcement · third-party proprietary ·&#10;court · election · shared-record constraints&#10;→ special windows / limits (state-gated)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="770" y="650" width="340" height="88" as="geometry"/></mxCell><mxCell id="exit" value="→ REDACTION&#10;(all responsive items attached)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="780" width="340" height="54" as="geometry"/></mxCell><mxCell id="gap" value="⚠ Search adequacy is a SOFT standard everywhere —&#10;no state sets a numeric “search deadline”; the binding&#10;clock is the RESPONSE / production clock. City sets&#10;operational search targets (drives My Tasks aging)." style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="650" width="320" height="110" as="geometry"/></mxCell><mxCell id="leg" value="STATE COVERAGE&#10;Reasonable-search / organize duty: OH·WA&#10;Burden / categorical limit: WA (+ IL·KS·PA burden denial)&#10;No duty to create/convert: 16 states&#10;Programming ≠ creation: TX 552.231 (electronic data)&#10;Website satisfies: 8 states&#10;Installments: 7 states (param)&#10;Completion windows (archived): 10 states → named timers" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="320" height="160" as="geometry"/></mxCell><mxCell id="pgS_ovleg" value="OVERLAY:  unmarked = SHARED logic (identical everywhere)   ·   ◆ = VALUE KNOB (per-state/city config fills a value)   ·   ▲ = STATE-GATED BRANCH (active only for some states)" style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="20" y="954" width="1100" height="20" as="geometry"/></mxCell><mxCell id="pgS_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="e1" target="s1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="s2" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e4" value="none" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d1" target="bn"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e5" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d1" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e6" value="new record → decline part" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d2" target="nod"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e7" value="existing data → cost" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d2" target="prog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e8" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e9" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d3" target="web"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e10" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d3" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e11" value="copy still wanted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="web" target="d4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e12" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d4" target="inst"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e13" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d4" target="spec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="inst" target="spec"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="spec" target="exit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgS_e16" value="rest continues" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="nod" target="exit"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Redaction" id="pgR"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="880"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Redaction sub-flow (+ Legal Redaction) — segregability default · mandatory PII · third-party claims · marking" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="980" height="26" as="geometry"/></mxCell><mxCell id="e1" value="From Records Search — responsive set attached" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="56" width="380" height="54" as="geometry"/></mxCell><mxCell id="r1" value="◆ Review against exemption / reason library&#10;(config: per-state catalog loaded at setup)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="140" width="380" height="60" as="geometry"/></mxCell><mxCell id="seg" value="SEGREGABILITY IS THE DEFAULT (25 states)&#10;Release non-exempt portions; redact the rest —&#10;blanket denial improper where redaction is&#10;feasible; a redaction = PARTIAL DENIAL&#10;(explanation duty attaches, e.g. OH (B)(3))" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#c0a000;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="140" width="340" height="104" as="geometry"/></mxCell><mxCell id="d1" value="Any exempt content?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="232" width="290" height="70" as="geometry"/></mxCell><mxCell id="clean" value="NONE → DISPOSITION&#10;(no redaction; auto-pass)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="238" width="300" height="58" as="geometry"/></mxCell><mxCell id="pii" value="◆ MANDATORY / AUTO-REDACT CLASSES&#10;SSN + statutory identifiers (7 states) ·&#10;protected-person addresses: victims ·&#10;officers · program participants (4 states)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="330" height="88" as="geometry"/></mxCell><mxCell id="r2" value="◆ Apply redactions — mark visibly / note each&#10;redaction (marking duty: 4 states);&#10;EVERY redaction carries reason + citation&#10;→ feeds partial-denial comm (VA particularity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="340" height="88" as="geometry"/></mxCell><mxCell id="d2" value="Third-party interest?&#10;(trade secret · personnel ·&#10;named person)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="470" width="290" height="80" as="geometry"/></mxCell><mxCell id="tp" value="▲ THIRD-PARTY NOTICE / CLAIM (state-gated)&#10;UT business-confidentiality claim (12-bd CAO path) ·&#10;personnel-privacy objection process (MI…) ·&#10;discretionary notice (3 states) → EXTERNAL WAIT&#10;timer (clock matrix; response window per state)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2d0;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="470" width="340" height="100" as="geometry"/></mxCell><mxCell id="d3" value="◆ Legal review needed?&#10;(config: force-route option)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="445" y="600" width="290" height="70" as="geometry"/></mxCell><mxCell id="legal" value="LEGAL REDACTION (spawnable escalation)&#10;dedicated UI · submit-complete → back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="340" height="60" as="geometry"/></mxCell><mxCell id="lab" value="REDACTION LABOR — chargeability varies (ledger):&#10;never chargeable: OH (exc. police video $75/hr,&#10;$750 cap) · PA · NV…  TX: exemption-REVIEW time&#10;never chargeable (1 TAC 70.3); physical redaction&#10;only inside $15/hr processing when labor is&#10;chargeable at all.  KS: lowest-cost staff (45-219(c))" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="470" width="330" height="130" as="geometry"/></mxCell><mxCell id="exit" value="→ DISPOSITION&#10;partial withholding → Denial comm (partial)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="710" width="340" height="58" as="geometry"/></mxCell><mxCell id="leg" value="STATE COVERAGE&#10;Segregability: 25 states&#10;Mandatory PII: 7 · Protected person: 4&#10;Marking / explanation: 4&#10;Third-party claim/notice: UT · MI · +3 discretionary&#10;AG-referral states: the WITHHOLD decision itself&#10;needs the AG (TX → Denial page AG band), not staff" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="700" width="340" height="140" as="geometry"/></mxCell><mxCell id="pgR_ovleg" value="OVERLAY:  unmarked = SHARED logic (identical everywhere)   ·   ◆ = VALUE KNOB (per-state/city config fills a value)   ·   ▲ = STATE-GATED BRANCH (active only for some states)" style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="20" y="854" width="1100" height="20" as="geometry"/></mxCell><mxCell id="pgR_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="e1" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="r1" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e3" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d1" target="clean"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e4" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e5" value="always applied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="pii" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="r2" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e7" value="yes → notice / wait" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d2" target="tp"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e8" value="resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="tp" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e9" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e10" value="yes / forced" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d3" target="legal"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e11" value="approved → back" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="legal" target="exit"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="pgR_e12" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="d3" target="exit"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Disposition" id="pgX"><mxGraphModel dx="1300" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1180" pageHeight="720"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Disposition &amp; delivery sub-flow — end states · payment-at-release · delivery mechanics · retention" style="text;html=1;fontSize=14;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1000" height="26" as="geometry"/></mxCell><mxCell id="e1" value="Item resolved: produced / redacted set ready ·&#10;or denied / withdrawn upstream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="56" width="400" height="56" as="geometry"/></mxCell><mxCell id="d1" value="Balance adequate?&#10;(parent financial processor —&#10;ship-auth gate)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="150" width="320" height="76" as="geometry"/></mxCell><mxCell id="hold" value="▲ PAY-BEFORE-RELEASE (AL·AZ·IL·KS·MA·NE·NV·OH)&#10;→ HOLD–Awaiting Payment at delivery&#10;(child hidden from My Tasks; parent stays queued)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff9c4;strokeColor=#c0a000;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="150" width="340" height="84" as="geometry"/></mxCell><mxCell id="unc" value="UNCLAIMED / NONPAYMENT TERMINAL TIMERS&#10;TX: 60d to inspect/pay after availability notice →&#10;WITHDRAWN (552.221(e)) · MI: deposit 45d → abandoned&#10;MO 90d · OR 60d nonpay-close · else city config ⚠&#10;→ named timers in the clock matrix" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#ffe0b2;strokeColor=#e65100;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="270" width="340" height="110" as="geometry"/></mxCell><mxCell id="cw" value="COMPLETION WINDOWS (10 states, param):&#10;archived / stored record windows (e.g. 21bd) ·&#10;MA municipal 25-bd production — named timers&#10;layered on the response clock" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="150" width="320" height="90" as="geometry"/></mxCell><mxCell id="fmt" value="◆ Deliver in requested format / medium&#10;(format duty: 27 states · no-medium-refusal: 3 ·&#10;electronic-if-exists: TX…) · email / download link /&#10;mail · certified copy on request (9 states)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="340" height="92" as="geometry"/></mxCell><mxCell id="caps" value="▲ REQUESTOR-LEDGER CHECK (class D)&#10;OH: ≤10/month physical delivery unless per-request&#10;non-commercial certification · electronic cap config&#10;→ decrement counters on actual delivery" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="270" width="320" height="84" as="geometry"/></mxCell><mxCell id="ship" value="SHIPPED — child terminal&#10;exemption citations attached for anything redacted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="410" width="340" height="58" as="geometry"/></mxCell><mxCell id="den" value="DENIED — child terminal&#10;(comm per Denial page)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="410" width="320" height="54" as="geometry"/></mxCell><mxCell id="wd" value="WITHDRAWN / CLOSED — timers or requester opt-out" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="340" height="54" as="geometry"/></mxCell><mxCell id="fin" value="PARENT ROLL-UP: final invoice · refund excess&#10;advance (OK: “shall be returned”) · unpaid balance →&#10;ledger class A (TX: cannot sue; deposit gate only)&#10;→ Financial Status final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="510" width="340" height="84" as="geometry"/></mxCell><mxCell id="ret" value="RETENTION: the request file (request + responses +&#10;comms) is itself a public record — retain per&#10;schedule (config); denial-log states (4) keep a&#10;denial registry" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="340" height="90" as="geometry"/></mxCell><mxCell id="close" value="PARENT CLOSED (Active/Closed flag)&#10;all children terminal + financial settled" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#999999;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="430" y="634" width="340" height="54" as="geometry"/></mxCell><mxCell id="leg" value="STATE COVERAGE&#10;Pay-before-release: 8 states&#10;Format / medium duty: 27 · no-refusal: 3&#10;Certified copy: 9 · Website satisfies: 8&#10;Delivery caps: OH (requestor ledger)&#10;Completion windows: 10 states&#10;Unclaimed / withdrawn: TX 60d · MI 45d ·&#10;MO 90d · OR 60d · rest config ⚠" style="shape=note;size=12;align=left;verticalAlign=top;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b3b3b3;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="510" width="320" height="178" as="geometry"/></mxCell><mxCell id="pgX_ovleg" value="OVERLAY:  unmarked = SHARED logic (identical everywhere)   ·   ◆ = VALUE KNOB (per-state/city config fills a value)   ·   ▲ = STATE-GATED BRANCH (active only for some states)" style="text;html=1;fontSize=11;fontStyle=2;align=left;fontColor=#666;" vertex="1" parent="1"><mxGeometry x="20" y="694" width="1100" height="20" as="geometry"/></mxCell><mxCell id="pgX_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=block;endFill=1;strokeColor=#555;" edge="1" parent="1" source="e1" target="d1"><mxGeometry relative="1" as="geo