    "initial_decision": { "concepts": ["response.initial_decision_window", "response.clock_computation", "denial.deemed_denial_on_nonresponse"] },
    "extension": { "concepts": ["response.extension_grounds", "response.extension_length", "response.extension_limit", "response.extension_notice", "external.court_dependent"] },
    "completion": { "concepts": ["production.completion_window"] },
    "clarification_response": { "concepts": ["clarification.nonresponse_withdrawal", "clarification.toll_on_clarification"] },
