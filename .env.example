# ─── Required ───────────────────────────────────────────────────────────────
# Anthropic API key powers the public portal chat agent, record search, and OQA
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# JWT secret used for staff session tokens — set to a long random string
JWT_SECRET=change-me-to-a-long-random-string

# ─── Server config ──────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Email (set these in the Configuration page, not here) ──────────────────
# Resend API key, SMTP host/user/pass, etc. are stored in the database via
# the staff Configuration page. They are not environment variables.
